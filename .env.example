# Copy to .env.local and fill in. Restart Next.js after editing.

# Required: Supabase project URL and publishable key.
# Never put a service-role or secret key in NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only: AI drafting of apology and delay wording, and read-only analytics summaries.
# Staff always review and publish drafts themselves.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
